{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "Default": "Data Source=(localdb)\\MSSQLLocalDB;Initial Catalog=Zust-DB;Integrated Security=True;",
    "Production": "your_db_connection"
  },
  "Cloudinary": {
    "CloudName": "your_cloudname",
    "ApiKey": "your_apikey",
    "ApiSecret": "your_secretkey"
  },
  "AllowedHosts": "*"
}
